IJM_API_KEY=replace-with-a-long-random-value
IJM_ADMIN_TOKEN=replace-with-a-different-long-random-value
IJM_SYNC_TOKEN=replace-with-an-optional-account-sync-token
IJM2API_PORT=8808
IJM_TIME_ZONE=Asia/Taipei
